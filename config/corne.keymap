#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip {
        chain-length = <27>;
};

/ {
        macros {
                rgb_kp: rgb_kp {
                        compatible = "zmk,behavior-macro-one-param";
                        #binding-cells = <1>;
                        wait-ms = <0>;
                        tap-ms = <0>;
                        bindings
                                = <&macro_tap &rgb_ug RGB_ON>
                                , <&macro_param_1to1>
                                , <&macro_press &kp MACRO_PLACEHOLDER>
                                , <&macro_pause_for_release>
                                , <&macro_param_1to1>
                                , <&macro_release &kp MACRO_PLACEHOLDER>
                                , <&macro_tap &rgb_ug RGB_OFF>;
                };

                rgb_mo: rgb_mo {
                        compatible = "zmk,behavior-macro-one-param";
                        #binding-cells = <1>;
                        wait-ms = <0>;
                        tap-ms = <0>;
                        bindings
                                = <&macro_tap &rgb_ug RGB_ON>
                                , <&macro_param_1to1>
                                , <&macro_press &mo MACRO_PLACEHOLDER>
                                , <&macro_pause_for_release>
                                , <&macro_param_1to1>
                                , <&macro_release &mo MACRO_PLACEHOLDER>
                                , <&macro_tap &rgb_ug RGB_OFF>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &rgb_kp TAB   &rgb_kp Q &rgb_kp W &rgb_kp E &rgb_kp R &rgb_kp T   &rgb_kp Y &rgb_kp U  &rgb_kp I     &rgb_kp O   &rgb_kp P    &rgb_kp BSPC
   &rgb_kp LCTRL &rgb_kp A &rgb_kp S &rgb_kp D &rgb_kp F &rgb_kp G   &rgb_kp H &rgb_kp J  &rgb_kp K     &rgb_kp L   &rgb_kp SEMI &rgb_kp SQT
   &rgb_kp LSHFT &rgb_kp Z &rgb_kp X &rgb_kp C &rgb_kp V &rgb_kp B   &rgb_kp N &rgb_kp M  &rgb_kp COMMA &rgb_kp DOT &rgb_kp FSLH &rgb_kp ESC
                  &rgb_kp LGUI &rgb_mo 1 &rgb_kp SPACE   &rgb_kp RET &rgb_mo 2 &rgb_kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT | RGB |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &rgb_kp TAB    &rgb_kp N1       &rgb_kp N2       &rgb_kp N3       &rgb_kp N4       &rgb_kp N5         &rgb_kp N6   &rgb_kp N7   &rgb_kp N8 &rgb_kp N9    &rgb_kp N0 &rgb_kp BSPC
   &bt BT_CLR     &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &rgb_kp LEFT &rgb_kp DOWN &rgb_kp UP &rgb_kp RIGHT &rgb_ug RGB_TOG &trans
   &rgb_kp LSHFT  &trans           &trans           &trans           &trans           &trans             &trans       &trans       &trans     &trans        &trans &trans
                                          &rgb_kp LGUI     &trans       &rgb_kp SPACE      &rgb_kp RET  &trans   &rgb_kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &rgb_kp  TAB  &rgb_kp EXCL &rgb_kp AT &rgb_kp HASH &rgb_kp DLLR &rgb_kp PRCNT   &rgb_kp CARET &rgb_kp AMPS  &rgb_kp ASTRK &rgb_kp LPAR &rgb_kp RPAR &rgb_kp BSPC
   &rgb_kp LCTRL &trans       &trans     &trans       &trans       &trans          &rgb_kp MINUS &rgb_kp EQUAL &rgb_kp LBKT  &rgb_kp RBKT &rgb_kp BSLH &rgb_kp GRAVE
   &rgb_kp LSHFT &trans       &trans     &trans       &trans       &trans          &rgb_kp UNDER &rgb_kp PLUS  &rgb_kp LBRC  &rgb_kp RBRC &rgb_kp PIPE &rgb_kp TILDE
                                      &rgb_kp LGUI &trans   &rgb_kp SPACE   &rgb_kp RET   &trans    &rgb_kp RALT
                        >;
                };
        };
};
